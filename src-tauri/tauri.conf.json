{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FilePreview",
  "version": "0.0.1",
  "identifier": "dev.local.filepreview",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1422",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FilePreview",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU1MEE3OTFFREM1QTA1MTgKUldRWUJWcmNIbmtLNVpJdStxWVh4WkkzVmNBS1FmckRZQlJHaDREeWYxZ3Rpb054MFEySEZLTjcK",
      "endpoints": ["https://github.com/quietforge-dev/FilePreview/releases/latest/download/latest.json"]
    }
  }
}
